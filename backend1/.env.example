# ──────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the app:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financial_monitor_db"

# The port the NestJS API server will listen on.
PORT=3000

# Application environment. Controls Prisma query logging verbosity.
# Values: development | production | test
NODE_ENV=development
